{% assign opts = trmnl.plugin_settings.custom_fields_values %}
<div class="layout layout--col h--full">
  <section class="map stretch w--full poc poc--half_vertical" data-focus="{{ focus.mmsi | escape }}" data-status="{{ status | default: 'unavailable' | escape }}" data-labels="{{ opts.ship_labels | escape }}" data-mode="{{ opts.display_mode | default: 'map' | escape }}" data-bbox="{{ viewport | join: ',' | escape }}" data-center="{{ port.center | join: ',' | escape }}" aria-label="Recently reported vessel positions">
    <aside class="absolute bottom--10 lg:bottom--20 left--3 z--2 p--2 lg:p--3 bg--canvas outline flex flex--col flex--left gap--xsmall w--[48cqw] poc__box" data-poc-box>
      <span class="label label--small">Port of Call</span>
      {% if demo %}<span class="label label--small">DEMO · SYNTHETIC POSITIONS</span>{% endif %}
      <span class="w--full title title--small lg:title--large" data-clamp="3">{{ port.name | default: 'Harbor' | escape }}{% if port.country and port.country != port.name %}, {{ port.country | escape }}{% endif %}</span>
      <span class="w--full label label--small" data-clamp="3">{{ total | default: 0 }} vessels recently reported near this port</span>
      <span hidden><strong data-poc-total>{{ total | default: 0 }}</strong><span data-poc-limited></span></span>
      <span class="w--full description poc__notice"{% if status == 'ok' %} hidden{% endif %}>{{ message | default: 'Vessel feed unavailable' | escape }}</span>
      {% if focus_message %}<span class="w--full label label--small" data-clamp="2">{{ focus_message | escape }}</span>{% endif %}
    </aside>
    {% if focus %}
    {% assign copy = focus.presentation %}
    <aside class="poc__spotlight absolute z--2 p--2 inverse outline flex flex--col flex--left gap--xsmall w--auto w--min-[48cqw] w--max-[56cqw]" data-poc-spotlight data-id="{{ focus.mmsi | escape }}" aria-label="Ship Spotlight" style="opacity:0;left:8px;top:8px">
      <span class="w--full title title--base lg:title--large" data-clamp="1">{{ focus.name | escape }}</span>
      {% if copy.vessel_type %}<span class="w--full description" data-clamp="1">{{ copy.vessel_type | escape }}</span>{% endif %}
      {% if copy.flag %}<span class="w--full label label--small" data-clamp="2">{{ copy.flag | escape }}</span>{% endif %}
      {% if copy.journey %}<span class="w--full label" data-clamp="3"><span><strong>{{ copy.journey.label | escape }}:</strong> {{ copy.journey.value | escape }}</span></span>{% endif %}
      {% if copy.eta %}<span class="w--full label label--small" data-clamp="2"><span><strong>Reported ETA:</strong> {{ copy.eta | escape }}</span></span>{% endif %}
      {% if copy.speed %}<span class="w--full label" data-clamp="1"><span><strong>Current speed:</strong> {{ copy.speed | escape }}</span></span>{% endif %}
      {% if copy.highlights.size > 0 %}<div class="w--full flex flex--col flex--left gap--none" data-poc-highlights>
        <span class="label label--small font--bold">Good to know</span>
        {% for fact in copy.highlights limit: 1 %}<span class="w--full label label--small" data-clamp="2">{{ fact | escape }}</span>{% endfor %}
      </div>{% endif %}
      {% if copy.details.size > 0 or copy.measurements.size > 0 %}<div class="w--full flex flex--col flex--left gap--none" data-poc-details>
        <span class="label label--small font--bold">Ship details</span>
      {% if copy.details.size > 0 %}{% for fact in copy.details %}{% unless fact.label == 'Reported draught' %}<span class="w--full label label--small" data-clamp="2"><span><strong>{{ fact.label | escape }}:</strong> {{ fact.value | escape }}</span></span>{% endunless %}{% endfor %}{% endif %}
        {% if copy.measurements.size > 0 %}<div class="grid {% if copy.measurements.size > 1 %}grid--cols-2{% else %}grid--cols-1{% endif %} gap--small w--full" data-poc-stats>
          {% for fact in copy.measurements %}<span class="label label--small" data-clamp="2" data-poc-stat-caption>{{ fact.label | escape }}</span>{% endfor %}
          {% for fact in copy.measurements %}<span class="value value--xxsmall value--tnums" data-clamp="1" data-poc-stat-value>{{ fact.value | escape }}</span>{% endfor %}
        </div>{% endif %}
        {% for fact in copy.details %}{% if fact.label == 'Reported draught' %}<span class="w--full label label--small" data-clamp="1">{{ fact.label | escape }}: {{ fact.value | escape }}</span>{% endif %}{% endfor %}
      </div>{% endif %}
    </aside>
    {% endif %}
    <div class="map__attribution poc__attribution flex flex--wrap flex--right gap--xsmall w--max-[96cqw]" data-poc-sources>
      <span>{% if demo %}DEMO · synthetic data{% elsif attribution %}<a href="{{ attribution.url | escape }}">Fintraffic / digitraffic.fi</a> · <a href="{{ attribution.license | escape }}">CC BY 4.0</a>{% else %}{{ source | default: 'Source unavailable' | escape }}{% endif %}</span>
      {% if focus.enrichment or focus.flag or focus.built_in %}<span><a href="https://www.wikidata.org/">Wikidata</a> · <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a></span>{% endif %}
      <span><a href="https://www.openstreetmap.org/copyright">© OpenStreetMap contributors</a></span>
    </div>
    <ul class="poc__data" hidden>{% for v in vessels %}<li data-featured="{% if focus.mmsi == v.mmsi %}true{% else %}false{% endif %}" data-id="{{ v.mmsi | escape }}" data-lon="{{ v.position[0] }}" data-lat="{{ v.position[1] }}" data-bearing="{{ v.bearing_deg }}" data-stale="{{ v.stale }}" data-name="{{ v.name | escape }}" data-reported="{{ v.reported_at | escape }}"></li>{% endfor %}</ul>
  </section>
</div>
