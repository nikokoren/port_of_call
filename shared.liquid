   move to a line above it when not, so no word is ever cut. */
.poc .poc__corner { flex-wrap:wrap-reverse; align-items:flex-start; justify-content:flex-start; }
.poc .poc__attribution { position:static; white-space:normal; }
.poc__attribution a { color:inherit; text-decoration:none; pointer-events:auto; }
.poc__spotlight { z-index:6; left:8px; top:8px; }
/* Hidden while it is measured and placed. Clipping keeps its text measurable
   for native clamping (visibility:hidden would not), with no translucency on e-ink. */
.poc__spotlight--pending { clip-path:inset(0 0 100% 0); }
.poc__spotlight [hidden] { display:none; }
.poc .poc__spotlight-lines { z-index:5; }
.poc__box a { color:inherit; text-decoration:none; }
.poc__box [hidden] { display:none; }
.poc__ship { position:absolute; transform:translate(-50%,-50%); z-index:3; color:var(--poc-ink); }
.poc__ship svg { width:100%; height:100%; display:block; overflow:visible; }
/* Ships under way are solid ink; only the Spotlight ship keeps a paper outline. */
.poc__ship path { fill:currentColor; stroke:currentColor; stroke-width:1; stroke-linejoin:round; paint-order:stroke; }
.poc[data-focus]:not([data-focus=""]):not([data-spotlight-fallback="true"]) .poc__ship:not(.poc__ship--featured) { color:var(--poc-context); }
/* Grey context ships keep a dark edge so they stay legible on grey water. */
.poc[data-focus]:not([data-focus=""]):not([data-spotlight-fallback="true"]) .poc__ship:not(.poc__ship--featured) path { stroke:var(--poc-context-edge); stroke-width:2.6; }
.poc[data-focus]:not([data-focus=""]):not([data-spotlight-fallback="true"]) .poc__ship--stale:not(.poc__ship--featured) path { fill:var(--poc-paper); stroke:var(--poc-context-edge); stroke-width:1.8; }
.screen--1bit .poc[data-focus]:not([data-focus=""]):not([data-spotlight-fallback="true"]) .poc__ship:not(.poc__ship--featured) path { fill:var(--poc-paper); stroke:var(--poc-ink); stroke-width:1.1; }
/* Motion by fill: stopped ships are outlined; old reports (below) are dashed. */
.poc__ship--stopped path { fill:var(--poc-paper); stroke:currentColor; stroke-width:1.8; }
.poc__ship--featured { z-index:4; }
.poc__ship--featured path { stroke:var(--poc-paper); stroke-width:3; }
.poc__ship--stale path { fill:var(--poc-paper); stroke:currentColor; stroke-width:1.6; stroke-dasharray:2.4 1.8; }
.poc__label { position:absolute; z-index:4; pointer-events:none; }
/* Bound overlay text before measuring it; type/paint/spacing use native roles. */
.poc__label .label { display:block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.poc__label-route { border-top:1px solid currentColor; }
.poc__lines { position:absolute; inset:0; width:100%; height:100%; z-index:2; color:var(--poc-ink); pointer-events:none; }
.poc__lines line { vector-effect:non-scaling-stroke; stroke-linecap:round; }
.poc__leader-halo { stroke:var(--poc-paper); stroke-width:3px; }
.poc__leader { stroke:currentColor; stroke-width:1px; }
/* Only the Spotlight connector receives the stronger ink and separation halo. */
.poc__spotlight-lines .poc__leader { stroke-width:3px; }
.poc__spotlight-lines .poc__leader-halo { stroke-width:7px; }
.screen--dark-mode .poc { --poc-paper:#000; --poc-ink:#fff; --poc-context:#aaa; --poc-context-edge:#000; }
