        var count=el.querySelector('[data-poc-limited]'),total=Number(el.querySelector('[data-poc-total]').textContent)||0;
        count.textContent=visible<total?' · '+visible+' shown':'';
        if(el.dataset.labels!=='on')return;
        var boxes=shown.map(function(s){return s.box;}).concat(reserved),lines=annotation?[annotation.line]:[];
        var svg=document.createElementNS('http://www.w3.org/2000/svg','svg');
        svg.setAttribute('class','poc__lines');svg.setAttribute('viewBox','0 0 '+W+' '+H);el.appendChild(svg);
        // One label per 48,000 px² of map (8 on a full OG screen, 16 on a full
        // TRMNL X), at most 16. The backend ranks ships by interest; ships it
        // did not rank go last, newest first.
        var placed=0,limit=Math.max(2,Math.min(16,Math.round(W*H/(unit*unit)/48000)));
        function rankOf(s){var r=Number(s.data.rank);return s.data.rank&&Number.isFinite(r)?r:Infinity;}
        shown.sort(function(a,b){return (b.featured-a.featured)||(rankOf(a)-rankOf(b))||b.data.reported.localeCompare(a.data.reported)||a.data.id.localeCompare(b.data.id);}).forEach(function(s){
          if(s.featured||!s.data.name||placed>=limit)return;
          var label=document.createElement('div');
          label.className='poc__label bg--canvas outline p--1 flex flex--col flex--left gap--none';
          label.style.maxWidth=Math.min(200*unit,W*.45)+'px';
          label.style.left='0px';label.style.top='0px';
          var name=document.createElement('span');name.className='w--full label label--small font--bold';
          name.textContent=s.data.name;label.appendChild(name);
          if(s.data.voyage){
            var route=document.createElement('span');route.className='poc__label-route w--full label label--small';
            route.textContent=s.data.voyage;label.appendChild(route);
          }
          label.title=s.data.name+(s.data.voyage?' · '+s.data.voyage:'');
          el.appendChild(label);
          // Reserve the box, stroke and the existing native font-pass safety margin.
          var result=PortOfCallLabels.plan({x:s.x,y:s.y,icon:s.box,width:Math.ceil(label.offsetWidth*1.08)+4,
            height:label.offsetHeight+4,W:W,H:H,boxes:boxes,lines:lines,scale:unit});
          if(!result){label.remove();return;}
          label.dataset.id=s.data.id;label.style.left=(result.rect[0]+2)+'px';label.style.top=(result.rect[1]+2)+'px';
          boxes.push(result.rect);placed++;
          if(result.line) {
            lines.push(result.line);
            ['poc__leader-halo','poc__leader'].forEach(function(cls){
              var l=document.createElementNS('http://www.w3.org/2000/svg','line');l.setAttribute('class',cls);l.dataset.id=s.data.id;
              ['x1','y1','x2','y2'].forEach(function(k,i){l.setAttribute(k,result.line[i]);});svg.appendChild(l);
            });
          }
        });
      }
      setDeadline();
      function start() {
        if(window.__pocAssetsFailed){failure('Map assets unavailable · check network access');return;}
        if(!window.TRMNLMaps||!window.maplibregl) {if(!done)setTimeout(start,50);return;}
        var bounds=el.dataset.bbox.split(',').map(Number),center=el.dataset.center.split(',').map(Number);
        if(bounds.length!==4||!bounds.every(Number.isFinite)||bounds[0]>=bounds[2]){failure('Harbor data unavailable');return;}
        try {
          TRMNLMaps.watch(el,function(){
            done=false;delete el.dataset.mapReady;setDeadline();
            var map=new maplibregl.Map(TRMNLMaps.options({el:el,preset:'outline',center:center,zoom:10}));
            el.__portOfCallMap=map; // Visual checks compare actual marker pixels with projection.
            fit(map,bounds);
            map.on('error',function(){failure('Map tiles unavailable · check network access');});
            map.on('load',function(){
              Promise.all([document.fonts.ready,TRMNLMaps.ready(map)]).then(function(){
                if(!map.getContainer().isConnected)return;
                // Fonts can change the box height after the first fit.
                fit(map,bounds);draw(map);
                map.on('moveend',function(){draw(map);});map.on('resize',function(){draw(map);});
                if(done)return;
                TRMNLMaps.ready(map).then(function(){
                  if(done)return;draw(map);
                  // The framework's final text pass (clamping, fonts) can resize the
                  // harbor card and the Spotlight card. Place overlays against the
                  // final sizes before reporting ready, so the capture never sees an
                  // annotation tucked under a card that grew.
                  if(window.terminalize)window.terminalize();
                  fit(map,bounds);draw(map);
                  done=true;clearTimeout(deadline);el.dataset.mapReady='true';
                });
                if(window.ResizeObserver){
                  // Any later size change of a fixed card re-runs placement.
                  var queued=false,sizes=new WeakMap(),ro=new ResizeObserver(function(entries){
                    var changed=entries.some(function(e){var r=e.contentRect,k=r.width+'x'+r.height,old=sizes.get(e.target);sizes.set(e.target,k);return old!==undefined&&old!==k;});
                    if(!changed||!done||queued)return;
                    queued=true;requestAnimationFrame(function(){queued=false;if(map.getContainer().isConnected){fit(map,bounds);draw(map);}});
                  });
                  [box,spotlight,el.querySelector('[data-poc-sources]')].forEach(function(n){if(n)ro.observe(n);});
                }
              });
            });
            map.on('remove',function(){el.querySelectorAll('.poc__ship,.poc__label,.poc__lines').forEach(function(n){n.remove();});});
            return map;
          });
        }catch(_){failure('Map unavailable · renderer could not start');}
      }
      start();
    });
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot);else setTimeout(boot,0);
})();

</script>
