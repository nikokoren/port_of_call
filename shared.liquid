<link onerror="window.__pocAssetsFailed=true" rel="stylesheet" href="https://trmnl.com/js/maplibre-gl/5.24.0/maplibre-gl.css">
<script onerror="window.__pocAssetsFailed=true" src="https://trmnl.com/js/maplibre-gl/5.24.0/maplibre-gl.js"></script>
<style>
/* Like Downstream, layout, typography and the inset card use native framework
   classes. Custom rules handle geographic overlays, leader lines and link inheritance. */
.poc { --poc-paper:#fff; --poc-ink:#000; overflow:hidden; }
.poc__box { z-index:5; }
.poc__box a { color:inherit; text-decoration:none; }
.poc__box [hidden] { display:none; }
.poc__ship { position:absolute; transform:translate(-50%,-50%); z-index:3; color:var(--poc-ink); }
.poc__ship svg { width:100%; height:100%; display:block; overflow:visible; }
.poc__ship path { fill:currentColor; stroke:var(--poc-paper); stroke-width:2; paint-order:stroke; }
.poc[data-focus]:not([data-focus=""]) .poc__ship:not(.poc__ship--featured) path { fill:var(--poc-paper); stroke:currentColor; stroke-width:1.3; }
.poc__ship--featured { z-index:4; }
.poc__ship--featured path { stroke-width:3; }
.poc__ship--stale path { fill:var(--poc-paper); stroke:currentColor; stroke-width:1.8; }
.poc__label { position:absolute; z-index:4; white-space:nowrap; line-height:1; pointer-events:none; }
.poc__lines { position:absolute; inset:0; width:100%; height:100%; z-index:2; color:var(--poc-ink); pointer-events:none; }
.poc__lines line { vector-effect:non-scaling-stroke; stroke-linecap:round; }
.poc__leader-halo { stroke:var(--poc-paper); stroke-width:3px; }
.poc__leader { stroke:currentColor; stroke-width:1px; }
.screen--dark-mode .poc { --poc-paper:#000; --poc-ink:#fff; }
</style>
<script data-poc-label-engine>
(function () {
  if (window.PortOfCallLabels) return;
  // Adapted from nikokoren/hotspots HSMap.placeLabels: four adjacent placements,
  // then seven distances along sixteen directions. Only labels move, never ships.
  var ANGLES = [0,180,-45,-135,45,135,-90,90,-22.5,-157.5,22.5,157.5,-67.5,-112.5,67.5,112.5];
  function overlaps(a,b) {return a[0]<b[2] && b[0]<a[2] && a[1]<b[3] && b[1]<a[3];}
  function lineHits(line, boxes) {
    // Exact segment/rectangle clipping also catches narrow obstacles between samples.
    return boxes.some(function (b) {
      var lo=0, hi=1, dx=line[2]-line[0], dy=line[3]-line[1];
      var p=[-dx,dx,-dy,dy], q=[line[0]-b[0],b[2]-line[0],line[1]-b[1],b[3]-line[1]];
      for(var i=0;i<4;i++) {
        if(p[i]===0) {if(q[i]<0)return false;}
        else {var t=q[i]/p[i];if(p[i]<0)lo=Math.max(lo,t);else hi=Math.min(hi,t);if(lo>hi)return false;}
      }
      return hi>0 && lo<1;
    });
  }
  function plan(o) {
    var x=o.x,y=o.y,ib=o.icon,g=3*o.scale;
    var boxes=o.boxes, lines=o.lines||[], tw=o.width, th=o.height;
    function fits(b) {
      return b[0]>=2 && b[1]>=2 && b[2]<=o.W-2 && b[3]<=o.H-2 &&
        !boxes.some(function(a){return overlaps(b,a);}) && !lines.some(function(l){return lineHits(l,[b]);});
    }
    function rect(anchor,ex,ey,vertical) {
      if(anchor==='start')return [ex,ey-th/2,ex+tw,ey+th/2];
      if(anchor==='end')return [ex-tw,ey-th/2,ex,ey+th/2];
      return vertical<0?[ex-tw/2,ey-th,ex+tw/2,ey]:[ex-tw/2,ey,ex+tw/2,ey+th];
    }
    var near=[['start',ib[2]+g,y,0],['end',ib[0]-g,y,0],['middle',x,ib[1]-g,-1],['middle',x,ib[3]+g,1]];
    for(var n=0;n<near.length;n++) {
      var a=near[n],r=rect(a[0],a[1],a[2],a[3]);
      if(fits(r))return {rect:r,line:null};
    }
    var steps=[.015,.025,.035,.05,.065,.08,.10];
    for(var si=0;si<steps.length;si++)for(var ai=0;ai<ANGLES.length;ai++) {
      var rad=ANGLES[ai]*Math.PI/180,dx=Math.cos(rad),dy=Math.sin(rad);
      var tx=Math.abs(dx)>1e-9?((dx>0?ib[2]:ib[0])-x)/dx:Infinity;
      var ty=Math.abs(dy)>1e-9?((dy>0?ib[3]:ib[1])-y)/dy:Infinity;
      var r0=Math.max(0,Math.min(tx,ty)), ex=x+dx*(r0+steps[si]*o.W),ey=y+dy*(r0+steps[si]*o.W);
      var anchor=dx>.3?'start':dx<-.3?'end':'middle', r=rect(anchor,ex,ey,dy);
      var line=[x+dx*r0,y+dy*r0,ex,ey];
      // The line may touch its own icon only; boxes include all other icons and overlays.
      var blockers=boxes.filter(function(b){return b!==ib;});
      if(fits(r)&&!lineHits(line,blockers))return {rect:r,line:line};
    }
    return null;
  }
  window.PortOfCallLabels={plan:plan,overlaps:overlaps,lineHits:lineHits};
})();

</script>
<script>
(function () {
  function boot() {
    document.querySelectorAll('.poc:not([data-started])').forEach(function (el) {
      el.dataset.started='true';
      var notice=el.querySelector('.poc__notice'),box=el.querySelector('[data-poc-box]');
      var full=el.classList.contains('poc--full'),quad=el.classList.contains('poc--quadrant');
      var done=false,deadline;
      function failure(text) {
        if(done)return;
        notice.textContent=text;notice.hidden=false;el.dataset.mapReady='error';done=true;
      }
      function setDeadline() {clearTimeout(deadline);deadline=setTimeout(function(){failure('Map unavailable · check network access');},18000);}
      function rect(node) {
        var a=node.getBoundingClientRect(),b=el.getBoundingClientRect();
        return [a.left-b.left,a.top-b.top,a.right-b.left,a.bottom-b.top];
      }
      function scale() {return Math.max(1,parseFloat(getComputedStyle(el.closest('.screen')).getPropertyValue('--ui-scale'))||1);}
      function blockers() {
        return [box].concat(Array.from(el.querySelectorAll('.map__attribution'))).map(rect);
      }
      function fit(map,bounds) {
        // Downstream's framing: reserve the box's side or the area above it,
        // whichever gives the reviewed harbor extent more room. Never fit to ships.
        var g=12*scale(),r=rect(box),W=el.clientWidth,H=el.clientHeight;
        var beside={top:g,right:g,bottom:g,left:r[2]+g};
        var above={top:g,right:g,bottom:H-r[1]+g,left:g};
        var pad=(W-r[2])*H>=W*r[1]?beside:above;
        if(W-pad.left-pad.right<40 || H-pad.top-pad.bottom<40)pad={top:g,right:g,bottom:g,left:g};
        TRMNLMaps.fit(map,[[bounds[0],bounds[1]],[bounds[2],bounds[3]]],{padding:pad,maxZoom:14});
        var featured=el.querySelector('.poc__data li[data-featured="true"]');
        if(featured)map.easeTo({center:[Number(featured.dataset.lon),Number(featured.dataset.lat)],
          offset:[(pad.left-pad.right)/2,(pad.top-pad.bottom)/2],duration:0});
      }
      function draw(map) {
        el.querySelectorAll('.poc__ship,.poc__label,.poc__lines').forEach(function(n){n.remove();});
        var W=el.clientWidth,H=el.clientHeight,unit=scale(),size=16*unit;
        var reserved=blockers(),shown=[];
        el.querySelectorAll('.poc__data li').forEach(function (v) {
          var coord=[Number(v.dataset.lon),Number(v.dataset.lat)];
          if(!coord.every(Number.isFinite))return;
          var featured=v.dataset.featured==='true',factor=featured?1.5:1;
          var pt=map.project(coord),bearing=v.dataset.bearing===''?null:Number(v.dataset.bearing);
          // Rotation-aware icon bounds; do not move markers to make room for names.
          var angle=(bearing||0)*Math.PI/180;
          var iw=(Math.abs(Math.cos(angle))*16+Math.abs(Math.sin(angle))*20)*unit*factor;
          var ih=(Math.abs(Math.sin(angle))*16+Math.abs(Math.cos(angle))*20)*unit*factor;
          var ib=[pt.x-iw/2,pt.y-ih/2,pt.x+iw/2,pt.y+ih/2];
          if(ib[0]<2||ib[1]<2||ib[2]>W-2||ib[3]>H-2||reserved.some(function(b){return PortOfCallLabels.overlaps(ib,b);})||
             shown.some(function(s){return Math.hypot(s.x-pt.x,s.y-pt.y)<size;}))return;
          var glyph=document.createElement('div');
          glyph.className='poc__ship'+(featured?' poc__ship--featured':'')+(v.dataset.stale==='true'?' poc__ship--stale':'');
          glyph.style.left=pt.x+'px';glyph.style.top=pt.y+'px';glyph.style.width=(16*unit*factor)+'px';glyph.style.height=(20*unit*factor)+'px';
          glyph.dataset.featured=String(featured);glyph.dataset.id=v.dataset.id;glyph.dataset.lon=coord[0];glyph.dataset.lat=coord[1];
          glyph.title=v.dataset.name||v.dataset.id;
          glyph.innerHTML='<svg viewBox="0 0 18 22" aria-hidden="true"><path d="'+
            (bearing===null?'M9 4 L15 11 L9 18 L3 11 Z':'M9 1 L15 10 L13 20 L5 20 L3 10 Z')+'"/></svg>';
          glyph.querySelector('svg').style.transform='rotate('+(bearing||0)+'deg)';
          el.appendChild(glyph);shown.push({x:pt.x,y:pt.y,box:ib,data:v.dataset});
        });
        var count=el.querySelector('[data-poc-limited]'),total=Number(el.querySelector('[data-poc-total]').textContent)||0;
        count.textContent=shown.length<total?' · '+shown.length+' shown':'';
        if(el.dataset.labels!=='on'&&!el.dataset.focus)return;
        var boxes=shown.map(function(s){return s.box;}).concat(reserved),lines=[];
        var svg=document.createElementNS('http://www.w3.org/2000/svg','svg');
        svg.setAttribute('class','poc__lines');svg.setAttribute('viewBox','0 0 '+W+' '+H);el.appendChild(svg);
        var placed=0,limit=full?6:quad?2:4;
        shown.sort(function(a,b){return (b.data.featured==='true')-(a.data.featured==='true')||b.data.reported.localeCompare(a.data.reported)||a.data.id.localeCompare(b.data.id);}).forEach(function(s){
          if(!s.data.name||placed>=limit||(el.dataset.labels!=='on'&&s.data.featured!=='true'))return;
          var label=document.createElement('span');label.className='poc__label label label--small text-stroke';
          label.textContent=s.data.name;if(s.data.featured==='true'){label.classList.remove('text-stroke');label.classList.add('label--inverted');}el.appendChild(label);
          // Leave the same measurement safety margin used by Hotspots' font pass.
          function place(){return PortOfCallLabels.plan({x:s.x,y:s.y,icon:s.box,width:Math.ceil(label.offsetWidth*1.08)+4,
            height:label.offsetHeight+4,W:W,H:H,boxes:boxes,lines:lines,scale:unit});}
          var result=place(),nameChars=Array.from(s.data.name),chars=nameChars.length;
          // A long featured name may be abbreviated on the map; the card and
          // underlying data retain it. Never move the reported position.
          while(!result&&s.data.featured==='true'&&chars>6){
            chars=Math.max(6,chars-3);label.textContent=nameChars.slice(0,chars).join('')+'…';result=place();
          }
          if(!result){label.remove();return;}
          label.dataset.id=s.data.id;label.style.left=(result.rect[0]+2)+'px';label.style.top=(result.rect[1]+2)+'px';
          boxes.push(result.rect);placed++;
          if(result.line) {
            lines.push(result.line);
            ['poc__leader-halo','poc__leader'].forEach(function(cls){
              var l=document.createElementNS('http://www.w3.org/2000/svg','line');l.setAttribute('class',cls);l.dataset.id=s.data.id;
              ['x1','y1','x2','y2'].forEach(function(k,i){l.setAttribute(k,result.line[i]);});svg.appendChild(l);
            });
          }
        });
      }
      setDeadline();
      function start() {
        if(window.__pocAssetsFailed){failure('Map assets unavailable · check network access');return;}
        if(!window.TRMNLMaps||!window.maplibregl) {if(!done)setTimeout(start,50);return;}
        var bounds=el.dataset.bbox.split(',').map(Number),center=el.dataset.center.split(',').map(Number);
        if(bounds.length!==4||!bounds.every(Number.isFinite)||bounds[0]>=bounds[2]){failure('Harbor data unavailable');return;}
        try {
          TRMNLMaps.watch(el,function(){
            done=false;delete el.dataset.mapReady;setDeadline();
            var map=new maplibregl.Map(TRMNLMaps.options({el:el,preset:'outline',center:center,zoom:10}));
            el.__portOfCallMap=map; // Visual checks compare actual marker pixels with projection.
            fit(map,bounds);
            map.on('error',function(){failure('Map tiles unavailable · check network access');});
            map.on('load',function(){
              Promise.all([document.fonts.ready,TRMNLMaps.ready(map)]).then(function(){
                if(!map.getContainer().isConnected)return;
                // Fonts can change the box height after the first fit.
                fit(map,bounds);draw(map);
                map.on('moveend',function(){draw(map);});map.on('resize',function(){draw(map);});
                if(done)return;
                TRMNLMaps.ready(map).then(function(){
                  if(done)return;draw(map);done=true;clearTimeout(deadline);el.dataset.mapReady='true';
                  if(window.terminalize)window.terminalize();
                });
              });
            });
            map.on('remove',function(){el.querySelectorAll('.poc__ship,.poc__label,.poc__lines').forEach(function(n){n.remove();});});
            return map;
          });
        }catch(_){failure('Map unavailable · renderer could not start');}
      }
      start();
    });
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot);else setTimeout(boot,0);
})();

</script>
