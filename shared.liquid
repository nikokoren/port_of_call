/* Like Downstream, layout, typography and the inset card use native framework
   classes. Custom rules handle geographic overlays, leader lines and link inheritance. */
.poc { --poc-paper:#fff; --poc-ink:#000; --poc-context:#888; --poc-context-edge:#000; overflow:hidden; }
.poc__corner { z-index:7; }
.poc__box { flex-shrink:0; }
.poc__credits { flex:1 1 0; min-width:min-content; }
