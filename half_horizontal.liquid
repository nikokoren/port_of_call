{% assign opts = trmnl.plugin_settings.custom_fields_values %}
<div class="layout layout--col h--full">
  <section class="map stretch w--full poc poc--half_horizontal" data-focus="{{ focus.mmsi | escape }}" data-status="{{ status | default: 'unavailable' | escape }}" data-labels="{% if opts.ship_labels == true or opts.ship_labels == 'true' or opts.ship_labels == 'on' %}on{% else %}off{% endif %}" data-bbox="{{ viewport | join: ',' | escape }}" data-zoom="{{ camera.zoom | escape }}" data-center="{% if camera.center %}{{ camera.center | join: ',' | escape }}{% else %}{{ port.center | join: ',' | escape }}{% endif %}" aria-label="Recent vessel positions">
    <div class="absolute bottom--3 left--3 right--3 flex flex--row flex--bottom gap--small poc__corner">
    <aside class="p--2 lg:p--3 bg--canvas outline flex flex--col flex--left gap--xsmall w--[45cqw] poc__box" data-poc-box>
      <span class="label label--small">Port of Call</span>
      {% if demo %}<span class="label label--small">DEMO · SYNTHETIC POSITIONS</span>{% endif %}
      <span class="w--full title title--small lg:title--large" data-clamp="3">{{ port.name | default: 'Harbor' | split: ' — ' | first | escape }}{% if port.country and port.country != port.name %}, {{ port.country | escape }}{% endif %}</span>
      <span class="w--full label label--small" data-clamp="3">{{ total | default: 0 }} vessels near this port</span>
      {% if opts.port_facts == true or opts.port_facts == 'true' %}{% if port_fact.text %}<span class="w--full label label--small hidden lg:block" data-clamp="3" data-poc-port-fact>{{ port_fact.text | escape }}</span>{% endif %}{% endif %}
      <span hidden><strong data-poc-total>{{ total | default: 0 }}</strong><span data-poc-limited></span></span>
      <span class="w--full description poc__notice"{% if status == 'ok' %} hidden{% endif %}>{{ message | default: 'Vessel feed unavailable' | escape }}</span>
      {% if focus_message %}<span class="w--full label label--small" data-clamp="2">{{ focus_message | escape }}</span>{% endif %}
    </aside>
    <div class="poc__credits text--right label label--small block" data-poc-sources>
      <span class="map__attribution poc__attribution inline">{% if demo %}DEMO · synthetic data{% elsif attribution %}<a href="{{ attribution.url | escape }}">Fintraffic / digitraffic.fi</a> · <a href="{{ attribution.license | escape }}">CC BY 4.0</a>{% else %}{{ source | default: 'Source unavailable' | escape }}{% endif %}</span>
      <span class="map__attribution poc__attribution inline"><a href="https://www.openstreetmap.org/copyright">© OpenStreetMap contributors</a></span>
    </div>
    </div>
    {% if focus %}
    {% assign copy = focus.presentation %}
    <aside class="poc__spotlight poc__spotlight--pending absolute z--2 p--2 inverse outline flex flex--col flex--left gap--none w--auto w--min-[30cqw] w--max-[42cqw]" data-poc-spotlight data-id="{{ focus.mmsi | escape }}" aria-label="Ship Spotlight">
      <span class="w--full title title--small lg:title--large" data-clamp="1" data-clamp-lg="2">{{ focus.name | escape }}</span>
      {% if copy.vessel_type %}<span class="w--full label label--small" data-clamp="1" data-clamp-lg="2">{{ copy.vessel_type | escape }}</span>{% endif %}
      {% if copy.flag %}<span class="w--full label label--small" data-clamp="2">{{ copy.flag | escape }}</span>{% endif %}
      {% if copy.journey %}<span class="w--full label label--small" data-clamp="3"><span><strong>{{ copy.journey.label | escape }}:</strong> {{ copy.journey.value | escape }}</span></span>{% endif %}
      {% if copy.eta %}<span class="w--full label label--small" data-clamp="2"><span><strong>ETA:</strong> {{ copy.eta | escape }}</span></span>{% endif %}
      {% if copy.speed %}<span class="w--full label label--small" data-clamp="1" data-clamp-lg="2"><span><strong>Current speed:</strong> {{ copy.speed | escape }}</span></span>{% endif %}
      {% if copy.measurements.size > 0 %}<div class="w--full flex flex--col flex--left gap--none" data-poc-details>

        {% if copy.measurements.size > 0 %}<span class="w--full label label--small" data-clamp="2" data-poc-measurements><span>{% for fact in copy.measurements %}<strong>{{ fact.label | escape }}:</strong> {{ fact.value | escape }}{% unless forloop.last %} · {% endunless %}{% endfor %}</span></span>{% endif %}
      </div>{% endif %}
    </aside>
    {% endif %}

    <ul class="poc__data" hidden>{% for v in vessels %}<li data-featured="{% if focus.mmsi == v.mmsi %}true{% else %}false{% endif %}" data-id="{{ v.mmsi | escape }}" data-lon="{{ v.position[0] }}" data-lat="{{ v.position[1] }}" data-bearing="{{ v.bearing_deg }}" data-stale="{{ v.stale }}" data-name="{{ v.name | escape }}" data-voyage="{{ v.voyage | escape }}" data-reported="{{ v.reported_at | escape }}"></li>{% endfor %}</ul>
  </section>
</div>
