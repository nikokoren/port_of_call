# No credentials required for the default Finnish catalog.
PROVIDER=digitraffic
DB_PATH=var/positions.sqlite3
HOST=127.0.0.1
PORT=8080
POLL_SECONDS=300
FRESH_SECONDS=1800
EXPIRE_SECONDS=3600
# AISStream is private evaluation only until you have verified display/cache rights.
# PROVIDER=aisstream
# AISSTREAM_API_KEY=   # supply securely, never in markup
# AISSTREAM_RIGHTS_CONFIRMED=false
# ENABLE_DEMO=false
