{
  "name": "port-of-call",
  "main": "src/entry.py",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "PROVIDER": "digitraffic",
    "AISSTREAM_RIGHTS_CONFIRMED": "false"
  },
  "durable_objects": {
    "bindings": [{"name": "HARBOR", "class_name": "Harbor"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Harbor"]}],
  "observability": {"enabled": false}
}
